# Creen2API 网关 —— 环境变量样例
# 复制为 .env 并按需修改（.env 已被 .gitignore 忽略，切勿提交真实密钥）
#
# 说明：环境变量优先于 config.json，适合放密钥（避免落盘到配置文件）。

# ── 网关入口鉴权（对外部署必填）────────────────────────────────
# 客户端需携带 Authorization: Bearer <该值> 或 x-api-key: <该值>
CREEN_GATEWAY_API_KEY=

# ── 账号 token（可选，逗号分隔；追加到 config.json 的 tokens）──
# 浏览器登录 creen.ai 后从 LocalStorage 复制 x-auth-token
CREEN_TOKENS=

# ── 邮箱 API（验证码读取器）管理员密码 ──────────────────────────
# 覆盖 config.json 的 mail_api.admin_password，避免密码落盘
CREEN_MAIL_ADMIN_PASSWORD=

# ── 监听与上游（可选覆盖）──────────────────────────────────────
CREEN_LISTEN_ADDR=127.0.0.1:47840
CREEN_UPSTREAM_BASE_URL=https://www.creen.ai

# ── 配置路径（可选；默认工作目录 config.json）──────────────────
# CREEN_CONFIG=/app/config.json
